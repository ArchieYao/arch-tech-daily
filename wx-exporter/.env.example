# ==============================================================
# wx-exporter 环境变量模板 —— 复制为 .env 后再修改
#   PowerShell:  copy .env.example .env
#   bash/zsh:    cp .env.example .env
# 注意：.env 已在 .gitignore 中，不会被提交到仓库。
# ==============================================================

# 本地 we-mp-rss 后台地址（端口对应 docker-compose.yml 里的映射，默认 8002）
WERSS_BASE_URL=http://localhost:8002

# we-mp-rss 后台账号
# 强烈建议：首次启动后立刻在 we-mp-rss 后台修改默认密码，再同步改这里。
# 默认 admin / admin@123 是镜像出厂值，安全风险高。
WERSS_USERNAME=admin
WERSS_PASSWORD=admin@123

# 本地 we-mp-rss SQLite 数据文件路径（用 sql.js 直读）
# 默认指向 docker-compose.yml 挂载到本机的目录
WERSS_DB_PATH=./data/werss/db.db

# 本工具 Web UI 监听端口
PORT=3789

# 监听地址：
#   127.0.0.1 → 仅本机能打开（默认，最安全，强烈推荐）
#   0.0.0.0   → 允许局域网内其他设备访问
# 警告：本工具没有账号鉴权，BIND_HOST=0.0.0.0 会让同一局域网内任何人都能用，
#       并通过本工具间接读到你的微信扫码登录态和公众号订阅数据。请勿暴露公网。
BIND_HOST=127.0.0.1

# 导出产物目录（按 jobId 建子目录，含抓取的微信文章正文与图片）
OUTPUT_DIR=./data/exports
